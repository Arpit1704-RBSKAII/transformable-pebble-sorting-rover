"""
Interactive servo calibrator using SerialComm.
Prompts user to send commands like ARM,HOME or SORT,SMALL and observe physical movement.
Usage:
    python python/tools/servo_calibrate.py --port /dev/ttyUSB0
This tool will ask for a command and send it; it waits for responses and prints them.
Always ensure the mechanism has clearance before moving.
"""

import argparse
import time
from communication import SerialComm

def main(port, baud=115200):
    sc = SerialComm(port, baud, timeout=0.2)
    print("Connected to", port)
    print("Type commands to send to ESP32 (e.g., 'ARM,HOME', 'SORT,SMALL', 'TRANSFORM,FOLD'). Type 'q' to quit.")
    try:
        while True:
            cmd = input("send> ").strip()
            if cmd.lower() in ("q", "quit", "exit"):
                break
            if not cmd:
                continue
            print("Sending:", cmd)
            immediate = sc.send_command(cmd)
            if immediate:
                print("<<", immediate)
            try:
                resp = sc.wait_for(["DONE", "ERROR", "STATUS"], timeout=10.0)
                print("<<", resp)
            except TimeoutError:
                print("No response within timeout.")
    finally:
        sc.close()

if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--port", required=True)
    parser.add_argument("--baud", default=115200)
    args = parser.parse_args()
    main(args.port, args.baud)

