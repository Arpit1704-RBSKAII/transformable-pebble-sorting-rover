 """
test_detection.py
------------------
Unit tests for detection.py using SYNTHETIC frames (drawn circles/
shapes via OpenCV) instead of real camera input. This lets the
pipeline logic be verified on any machine without hardware attached,
same rationale as test_communication.py's fake serial approach.

Run with:
    python -m pytest python/tests/test_detection.py
or:
    python -m unittest python.tests.test_detection
"""

import sys
import os
import unittest

import numpy as np
import cv2

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

import configuration
from detection import detect_pebbles, detect_best_pebble, PebbleDetection


def make_synthetic_frame(circles, background_color=200, pebble_color=40, size=(480, 640)):
    """
    Builds a synthetic BGR frame with the given circles drawn as dark
    "pebbles" on a light background. circles is a list of
    (center_x, center_y, radius) tuples.
    """
    frame = np.full((size[0], size[1], 3), background_color, dtype=np.uint8)
    for cx, cy, r in circles:
        cv2.circle(frame, (cx, cy), r, (pebble_color, pebble_color, pebble_color), -1)
    return frame


class TestDetection(unittest.TestCase):
    def setUp(self):
        # Pebbles are drawn DARKER than the background in these tests,
        # so invert thresholding is required. Saved/restored so tests
        # don't leak config changes into each other or other test files.
        self._original_invert = configuration.DETECTION_INVERT_THRESHOLD
        configuration.DETECTION_INVERT_THRESHOLD = True

    def tearDown(self):
        configuration.DETECTION_INVERT_THRESHOLD = self._original_invert

    def test_detects_single_circle_at_correct_center(self):
        frame = make_synthetic_frame([(320, 240, 40)])
        detections = detect_pebbles(frame)
        self.assertEqual(len(detections), 1)
        # Allow a couple pixels of tolerance for contour/bbox rounding.
        self.assertAlmostEqual(detections[0].x, 320, delta=3)
        self.assertAlmostEqual(detections[0].y, 240, delta=3)
        self.assertTrue(detections[0].detected)

    def test_detects_multiple_circles(self):
        frame = make_synthetic_frame([(150, 150, 25), (400, 200, 45), (300, 350, 65)])
        detections = detect_pebbles(frame)
        self.assertEqual(len(detections), 3)

    def test_empty_frame_returns_no_detections(self):
        frame = make_synthetic_frame([])
        detections = detect_pebbles(frame)
        self.assertEqual(len(detections), 0)

    def test_tiny_noise_speck_is_filtered_out(self):
        # Radius 3 circle has area ~28px, well under MIN_CONTOUR_AREA_PX (200)
        frame = make_synthetic_frame([(50, 400, 3)])
        detections = detect_pebbles(frame)
        self.assertEqual(len(detections), 0)

    def test_elongated_smear_is_filtered_by_circularity(self):
        frame = make_synthetic_frame([])
        cv2.ellipse(frame, (550, 400), (60, 8), 0, 0, 360, (40, 40, 40), -1)
        detections = detect_pebbles(frame)
        self.assertEqual(len(detections), 0)

    def test_larger_circle_has_larger_area(self):
        frame = make_synthetic_frame([(150, 150, 25), (400, 200, 60)])
        detections = detect_pebbles(frame)
        self.assertEqual(len(detections), 2)
        areas = sorted(d.area_px for d in detections)
        self.assertLess(areas[0], areas[1])

    def test_detect_best_pebble_returns_highest_confidence(self):
        frame = make_synthetic_frame([(150, 150, 25), (400, 200, 45), (300, 350, 65)])
        best = detect_best_pebble(frame)
        all_detections = detect_pebbles(frame)
        self.assertEqual(best.confidence, max(d.confidence for d in all_detections))

    def test_detect_best_pebble_on_empty_frame(self):
        frame = make_synthetic_frame([])
        best = detect_best_pebble(frame)
        self.assertFalse(best.detected)

    def test_to_dict_shape(self):
        frame = make_synthetic_frame([(320, 240, 40)])
        best = detect_best_pebble(frame)
        result = best.to_dict()
        self.assertIn("detected", result)
        self.assertIn("x", result)
        self.assertIn("y", result)
        self.assertIn("confidence", result)
        # size/colour are NOT present yet - added in Phase 9/10 by classification.py
        self.assertNotIn("size", result)
        self.assertNotIn("colour", result)

    def test_detection_zone_filters_center_outside_zone(self):
        original_zone = configuration.DETECTION_ZONE_FRACTION
        try:
            # Restrict zone to left half of frame only
            configuration.DETECTION_ZONE_FRACTION = (0.0, 0.0, 0.5, 1.0)
            frame = make_synthetic_frame([(500, 240, 40)])  # center is in right half
            detections = detect_pebbles(frame)
            self.assertEqual(len(detections), 0)
        finally:
            configuration.DETECTION_ZONE_FRACTION = original_zone


if __name__ == "__main__":
    unittest.main()